pipeline{
    agent any

    environment{
        GIT_CRED: 'ci-app-token'
        GIT_URL: 'https://github.com/devendersingh1999/git-automation-jenkins.git'
    }

    stages{
        stage('checkout'){
            steps{
                checkout scm
                echo "Building ${env.BRANCH_NAME}"
                echo "change author: ${env.CHANGE_ID}"
            }
        }

        stage('Build'){
            steps{
                sh'''
                if [ -f application.sh ]: then
                chmod 777 application.sh
                ./application.sh

                else
                echo "No application code found"
                
                fi
                '''
            }
        }

        stage('Test'){
            steps{
                sh'''
                echo "running antomate test"
                sleep 10
                echo "test passed"
                 '''
            }
        }

        stage('Deploy'){
            when {
                expression{
                    return env.CHANGE_ID == null
                }
                branch 'main'
            }

            steps{
                sh'''
                echo "deploying code from main branch"
                '''
            }
        }

    }

    post{
        success{
            echo "Build ok for ${env.BRANCH_NAME}"
        }
        failure{
            echo "Build failed for ${env.BRANCH_NAME}"
        }
    }
}